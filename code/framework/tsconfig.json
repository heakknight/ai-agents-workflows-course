{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "rootDir": ".",
    "paths": {
      "#*": ["./agent/*"]
    }
  },
  "include": ["agent/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
