{
  "name": "customer-support-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "node init && eve build",
    "dev": "node init && eve dev",
    "dev:no-ui": "node init && eve dev --no-ui",
    "start": "node init && eve start",
    "info": "eve info",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.88",
    "ai": "^7.0.38",
    "eve": "^0.30.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "typescript": "7.0.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "ai": "^7.0.38"
  },
  "engines": {
    "node": ">=24"
  }
}
